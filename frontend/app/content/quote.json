"<section id=\"quote\">\n        <div class=\"wrap\">\n          <h2>Quote and tracking</h2>\n          <p class=\"sub\">Get a quick estimate or check where your parcel is.</p>\n          <div class=\"tools\">\n            <div class=\"card\">\n              <h3>Shipping estimate</h3>\n              <label for=\"w\">Weight (kg)</label\n              ><input id=\"w\" type=\"number\" min=\"1\" step=\"0.5\" value=\"20\" />\n              <label for=\"m\">Shipping method</label>\n              <select id=\"m\">\n                <option value=\"air\">Air freight (faster)</option>\n                <option value=\"sea\">Sea freight (cheaper)</option>\n              </select>\n              <p style=\"margin: 16px 0 0\">\n                <button class=\"btn\" id=\"calc\" type=\"button\">Calculate</button>\n              </p>\n              <div class=\"result\" id=\"out\" aria-live=\"polite\">\n                Enter your weight and press Calculate.\n              </div>\n              <p class=\"note\">\n                Example rates only. Update them in the page code before launch.\n              </p>\n            </div>\n            <div class=\"card\" id=\"track\">\n              <h3>Track your parcel</h3>\n              <label for=\"t\">Tracking number</label\n              ><input id=\"t\" type=\"text\" placeholder=\"e.g. CR123456\" />\n              <p style=\"margin: 16px 0 0\">\n                <button class=\"btn\" id=\"go\" type=\"button\">Track</button>\n              </p>\n              <div class=\"result\" id=\"tout\" aria-live=\"polite\">\n                Enter your tracking number.\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>"
