"<section id=\"book\">\n        <div class=\"wrap\">\n          <h2>Book your shipment</h2>\n          <p class=\"sub\">\n            Tell us what you want to ship and we will confirm the price and\n            pickup details.\n          </p>\n          <div class=\"card\">\n            <div class=\"contact\">\n              <div>\n                <label for=\"bn\">Full name *</label\n                ><input id=\"bn\" type=\"text\" autocomplete=\"name\" />\n                <label for=\"bp\">Phone / WhatsApp *</label\n                ><input id=\"bp\" type=\"tel\" autocomplete=\"tel\" />\n                <label for=\"be\">Email</label\n                ><input id=\"be\" type=\"email\" autocomplete=\"email\" />\n                <label for=\"bd\">Delivery city in Rwanda</label\n                ><input id=\"bd\" type=\"text\" placeholder=\"e.g. Kigali\" />\n              </div>\n              <div>\n                <label for=\"bt\">Type of product</label\n                ><select id=\"bt\"></select>\n                <label for=\"bw\">Approx. weight (kg)</label\n                ><input id=\"bw\" type=\"number\" min=\"1\" step=\"0.5\" />\n                <label for=\"bm\">Shipping method</label\n                ><select id=\"bm\">\n                  <option>Air freight</option>\n                  <option>Sea freight</option>\n                  <option>Not sure yet</option>\n                </select>\n                <label for=\"bpay\">Payment method *</label><select id=\"bpay\" required><option value=\"\">Choose a payment method</option><option>MTN Mobile Money</option><option>Airtel Money</option><option>Card / Bank Transfer</option><option>Discuss with company</option></select><p class=\"note\">Online checkout is sent after your quote is confirmed. Bank transfers are arranged with the company.</p><label for=\"bs\">Supplier city in China</label\n                ><input id=\"bs\" type=\"text\" placeholder=\"e.g. Guangzhou\" />\n              </div>\n            </div>\n            <label for=\"bx\">Describe your goods *</label\n            ><textarea\n              id=\"bx\"\n              placeholder=\"What are the items, how many boxes, any special handling?\"\n            ></textarea>\n            <p style=\"margin: 16px 0 0\">\n              <button class=\"btn\" id=\"bwa\" type=\"button\">\n                Book on WhatsApp</button\n              ><button class=\"btn alt\" id=\"bem\" type=\"button\"><svg class=\"brand-icon gmail-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"#4285F4\" d=\"M3 6.5V19h3.5V9.2z\"/><path fill=\"#34A853\" d=\"M17.5 9.2V19H21V6.5z\"/><path fill=\"#EA4335\" d=\"M3 6.5 12 13l9-6.5V5.2c0-1-.8-1.7-1.8-1.7H4.8C3.8 3.5 3 4.2 3 5.2z\"/><path fill=\"#FBBC04\" d=\"M3 6.5 6.5 9.2V19H4.8C3.8 19 3 18.2 3 17.2z\"/></svg>Book by email</button>\n            </p>\n            <div class=\"result\" id=\"bout\" aria-live=\"polite\">\n              Fields marked * are required.\n            </div>\n          </div>\n        </div>\n      </section>"
