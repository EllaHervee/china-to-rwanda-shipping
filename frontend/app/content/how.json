"<section id=\"how\">\n        <div class=\"wrap\">\n          <h2>How it works</h2>\n          <p class=\"sub\">Four steps from the supplier to your door.</p>\n          <div class=\"grid\">\n            <div class=\"card\">\n              <div class=\"num\">1</div>\n              <h3>Send us the order</h3>\n              <p>\n                Share your supplier details or have them deliver to our China\n                warehouse.\n              </p>\n            </div>\n            <div class=\"card\">\n              <div class=\"num\">2</div>\n              <h3>We receive and check</h3>\n              <p>\n                Goods are weighed, photographed and consolidated with other\n                parcels.\n              </p>\n            </div>\n            <div class=\"card\">\n              <div class=\"num\">3</div>\n              <h3>Ship by air or sea</h3>\n              <p>Pick the speed that fits your budget and timeline.</p>\n            </div>\n            <div class=\"card\">\n              <div class=\"num\">4</div>\n              <h3>Delivery in Rwanda</h3>\n              <p>\n                We handle customs clearance and deliver in Kigali or pickup in\n                our office.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>"
