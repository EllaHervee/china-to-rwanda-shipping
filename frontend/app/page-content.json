"<header>\n      <div class=\"wrap\">\n        <a class=\"brand\" href=\"#top\">\n          <svg\n            width=\"44\"\n            height=\"36\"\n            viewBox=\"160 40 360 210\"\n            aria-hidden=\"true\"\n          >\n            <circle cx=\"330\" cy=\"125\" r=\"72\" fill=\"#f59e0b\" />\n            <path\n              d=\"M170 202C175 90 280 45 470 55C310 80 240 125 225 202Z\"\n              fill=\"#1e2a78\"\n            />\n            <rect x=\"225\" y=\"166\" width=\"34\" height=\"24\" fill=\"#de2910\" />\n            <rect x=\"261\" y=\"166\" width=\"34\" height=\"24\" fill=\"#fad201\" />\n            <rect x=\"297\" y=\"166\" width=\"34\" height=\"24\" fill=\"#00a1de\" />\n            <rect x=\"261\" y=\"142\" width=\"34\" height=\"24\" fill=\"#20603d\" />\n            <rect x=\"400\" y=\"140\" width=\"50\" height=\"50\" fill=\"#1e2a78\" />\n            <path d=\"M190 190H505Q485 224 452 237H225Z\" fill=\"#1e2a78\" />\n          </svg>\n          <span\n            >CHI<span style=\"color: var(--brand)\">-</span><b>RWA</b> CARGO</span\n          ></a\n        >\n        <nav>\n          <a href=\"#top\">Home</a><a class=\"hide\" href=\"#how\">How it works</a\n          ><a class=\"hide\" href=\"#products\">Products</a\n          ><a href=\"#quote\">Get a quote</a><a href=\"#book\">Book</a\n          ><a class=\"cta\" href=\"#contact\">Contact</a>\n        </nav>\n        <div class=\"sw\">\n          <select id=\"lang\" aria-label=\"Language\">\n            <option value=\"en\">English</option>\n            <option value=\"rw\">Kinyarwanda</option>\n            <option value=\"fr\">Français</option></select\n          ><select id=\"cur\" aria-label=\"Currency\">\n            <option value=\"USD\">$ USD</option>\n            <option value=\"RWF\">RWF</option>\n            <option value=\"CNY\">¥ CNY</option>\n          </select>\n        </div>\n      </div>\n    </header>\n\n    <main id=\"top\">\n      <div class=\"wrap hero\">\n        <div>\n          <h1>Ship from China to <span>Rwanda</span> – simply and safely</h1>\n          <p class=\"lead\">\n            Air and sea freight from Guangzhou, Shenzhen and Yiwu straight to\n            Kigali. We collect, consolidate, ship and clear customs for you.\n          </p>\n          <a class=\"btn\" href=\"#quote\">Get a free quote</a\n          ><a class=\"btn alt\" href=\"#track\">Track a parcel</a>\n        </div>\n        <div class=\"card\">\n          <h3>Why customers choose us</h3>\n          <p>\n            ✈️ Air freight in about 5–8 days<br />🚢 Sea freight in about 30–45\n            days<br />📦 Warehouse consolidation in China<br />📱 Updates on\n            WhatsApp<br />💳 Pay with MTN MoMo or Airtel Money\n          </p>\n        </div>\n      </div>\n\n      <section id=\"home-products\">\n        <div class=\"wrap\">\n          <h2>Products available to ship</h2>\n          <p class=\"sub\">Browse the products and shipping options available through CHI-RWA Cargo.</p>\n          <div class=\"grid\" id=\"home-plist\"></div>\n          <p style=\"margin: 20px 0 0\"><a class=\"btn\" href=\"#products\">View all products</a></p>\n        </div>\n      </section>\n\n      <section id=\"how\">\n        <div class=\"wrap\">\n          <h2>How it works</h2>\n          <p class=\"sub\">Four steps from the supplier to your door.</p>\n          <div class=\"grid\">\n            <div class=\"card\">\n              <div class=\"num\">1</div>\n              <h3>Send us the order</h3>\n              <p>\n                Share your supplier details or have them deliver to our China\n                warehouse.\n              </p>\n            </div>\n            <div class=\"card\">\n              <div class=\"num\">2</div>\n              <h3>We receive and check</h3>\n              <p>\n                Goods are weighed, photographed and consolidated with other\n                parcels.\n              </p>\n            </div>\n            <div class=\"card\">\n              <div class=\"num\">3</div>\n              <h3>Ship by air or sea</h3>\n              <p>Pick the speed that fits your budget and timeline.</p>\n            </div>\n            <div class=\"card\">\n              <div class=\"num\">4</div>\n              <h3>Delivery in Rwanda</h3>\n              <p>\n                We handle customs clearance and deliver in Kigali or pickup in\n                our office.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n<section id=\"products\">\n        <div class=\"wrap\">\n          <h2>Products we ship</h2>\n          <p class=\"sub\">\n            Popular goods our customers import from China. Ask us about anything\n            not listed.\n          </p>\n          <div class=\"grid\" id=\"plist\"></div>\n        </div>\n      </section>\n\n<section id=\"quote\">\n        <div class=\"wrap\">\n          <h2>Quote and tracking</h2>\n          <p class=\"sub\">Get a quick estimate or check where your parcel is.</p>\n          <div class=\"tools\">\n            <div class=\"card\">\n              <h3>Shipping estimate</h3>\n              <label for=\"w\">Weight (kg)</label\n              ><input id=\"w\" type=\"number\" min=\"1\" step=\"0.5\" value=\"20\" />\n              <label for=\"m\">Shipping method</label>\n              <select id=\"m\">\n                <option value=\"air\">Air freight (faster)</option>\n                <option value=\"sea\">Sea freight (cheaper)</option>\n              </select>\n              <p style=\"margin: 16px 0 0\">\n                <button class=\"btn\" id=\"calc\" type=\"button\">Calculate</button>\n              </p>\n              <div class=\"result\" id=\"out\" aria-live=\"polite\">\n                Enter your weight and press Calculate.\n              </div>\n              <p class=\"note\">\n                Example rates only. Update them in the page code before launch.\n              </p>\n            </div>\n            <div class=\"card\" id=\"track\">\n              <h3>Track your parcel</h3>\n              <label for=\"t\">Tracking number</label\n              ><input id=\"t\" type=\"text\" placeholder=\"e.g. CR123456\" />\n              <p style=\"margin: 16px 0 0\">\n                <button class=\"btn\" id=\"go\" type=\"button\">Track</button>\n              </p>\n              <div class=\"result\" id=\"tout\" aria-live=\"polite\">\n                Enter your tracking number.\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n<section id=\"book\">\n        <div class=\"wrap\">\n          <h2>Book your shipment</h2>\n          <p class=\"sub\">\n            Tell us what you want to ship and we will confirm the price and\n            pickup details.\n          </p>\n          <div class=\"card\">\n            <div class=\"contact\">\n              <div>\n                <label for=\"bn\">Full name *</label\n                ><input id=\"bn\" type=\"text\" autocomplete=\"name\" />\n                <label for=\"bp\">Phone / WhatsApp *</label\n                ><input id=\"bp\" type=\"tel\" autocomplete=\"tel\" />\n                <label for=\"be\">Email</label\n                ><input id=\"be\" type=\"email\" autocomplete=\"email\" />\n                <label for=\"bd\">Delivery city in Rwanda</label\n                ><input id=\"bd\" type=\"text\" placeholder=\"e.g. Kigali\" />\n              </div>\n              <div>\n                <label for=\"bt\">Type of product</label\n                ><select id=\"bt\"></select>\n                <label for=\"bw\">Approx. weight (kg)</label\n                ><input id=\"bw\" type=\"number\" min=\"1\" step=\"0.5\" />\n                <label for=\"bm\">Shipping method</label\n                ><select id=\"bm\">\n                  <option>Air freight</option>\n                  <option>Sea freight</option>\n                  <option>Not sure yet</option>\n                </select>\n                <label for=\"bs\">Supplier city in China</label\n                ><input id=\"bs\" type=\"text\" placeholder=\"e.g. Guangzhou\" />\n              </div>\n            </div>\n            <label for=\"bx\">Describe your goods *</label\n            ><textarea\n              id=\"bx\"\n              placeholder=\"What are the items, how many boxes, any special handling?\"\n            ></textarea>\n            <p style=\"margin: 16px 0 0\">\n              <button class=\"btn\" id=\"bwa\" type=\"button\">\n                Book on WhatsApp</button\n              ><button class=\"btn alt\" id=\"bem\" type=\"button\">\n                Book by email\n              </button>\n            </p>\n            <div class=\"result\" id=\"bout\" aria-live=\"polite\">\n              Fields marked * are required.\n            </div>\n          </div>\n        </div>\n      </section>\n\n<section id=\"contact\">\n        <div class=\"wrap\">\n          <h2>Contact and location</h2>\n          <p class=\"sub\">Talk to us about prices, pickups or your shipment.</p>\n          <div class=\"qa\">\n            <a class=\"btn\" href=\"tel:+250783553434\">📞 Call</a\n            ><a class=\"btn\" href=\"https://wa.me/250783553434\">💬 WhatsApp</a\n            ><a class=\"btn alt\" href=\"mailto:iradukundaellaherve@gmail.com\">✉️ Email</a>\n          </div>\n          <div class=\"contact\">\n            <div class=\"card\">\n              <div class=\"row tile\">\n                <span class=\"ti\">📞</span>\n                <div>\n                  <b>Phone / WhatsApp</b\n                  ><a href=\"tel:+250783553434\">0783553434</a><br /><a\n                    href=\"https://wa.me/250783553434\"\n                    >WhatsApp</a\n                  >\n                </div>\n              </div>\n              <div class=\"row tile\">\n                <span class=\"ti\">✉️</span>\n                <div>\n                  <b>Email</b\n                  ><a href=\"mailto:iradukundaellaherve@gmail.com\">iradukundaellaherve@gmail.com</a>\n                </div>\n              </div>\n              <div class=\"row tile\">\n                <span class=\"ti\">📍</span>\n                <div>\n                  <b>Office in Rwanda</b>Kigali, Rwanda<br /><a\n                    href=\"https://www.google.com/maps/search/?api=1&amp;query=Kigali+Rwanda\"\n                    >Open in Google Maps</a\n                  >\n                </div>\n              </div>\n              <div class=\"row tile\">\n                <span class=\"ti\">🏭</span>\n                <div><b>Warehouse in China</b>Guangzhou, China</div>\n              </div>\n              <div class=\"row tile\">\n                <span class=\"ti\">🕓</span>\n                <div><b>Opening hours</b>Mon–Sat, 8:00–18:00 (Kigali time)</div>\n              </div>\n            </div>\n            <div class=\"card\">\n              <h3>Send us a message</h3>\n              <label for=\"cn\">Your name</label><input id=\"cn\" type=\"text\" />\n              <label for=\"cm\">Message</label\n              ><textarea\n                id=\"cm\"\n                placeholder=\"What would you like to ship?\"\n              ></textarea>\n              <p style=\"margin: 16px 0 0\">\n                <button class=\"btn\" id=\"send\" type=\"button\">\n                  Send by email\n                </button>\n              </p>\n              <p class=\"note\">\n                This opens your email app with the message ready to send.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n    </main>\n\n    <footer>\n      <div class=\"wrap\">\n        <div>© 2026 CHI-RWA Cargo · China to Rwanda shipping</div>\n        <div>\n          <a href=\"https://wa.me/250783553434\">WhatsApp</a> ·\n          <a href=\"mailto:iradukundaellaherve@gmail.com\">iradukundaellaherve@gmail.com</a> · Kigali,\n          Rwanda\n        </div>\n      </div>\n    </footer>"
